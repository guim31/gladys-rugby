            "en": "Rugby Championship",
            "fr": "Rugby Championship",
            "de": "Rugby Championship",
            "es": "Rugby Championship"
          }
        },
        {
          "value": "nations_championship",
          "label": {
            "en": "Nations Championship (autumn tests)",
            "fr": "Nations Championship (tests d'automne)",
            "de": "Nations Championship (Herbst-Testspiele)",
            "es": "Nations Championship (test de otoño)"
          }
