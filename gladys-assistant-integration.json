  "actions": [
    {
      "key": "check",
      "label": {
        "en": "Check",
        "fr": "Vérifier",
        "de": "Prüfen",
        "es": "Comprobar"
      },
      "description": {
        "en": "Reads ESPN again now and shows the competitions read and your teams.",
        "fr": "Relit ESPN maintenant et affiche les compétitions lues et vos équipes.",
        "de": "Liest ESPN jetzt neu und zeigt die gelesenen Wettbewerbe und deine Teams.",
        "es": "Vuelve a leer ESPN ahora y muestra las competiciones leídas y sus equipos."
      },
      "timeout_seconds": 120
    }
  ],
