    {
      "key": "match_starting",
      "label": {
        "en": "Match starting soon",
        "fr": "Match qui va commencer",
        "de": "Spiel beginnt bald",
        "es": "Partido a punto de empezar"
      },
      "description": {
        "en": "Fires before the scheduled kick-off of a followed team, at the lead time chosen.",
        "fr": "Se déclenche avant le coup d'envoi prévu d'une équipe suivie, à l'avance choisie.",
        "de": "Löst vor dem geplanten Anstoß eines verfolgten Teams aus, mit der gewählten Vorlaufzeit.",
        "es": "Se activa antes del saque inicial previsto de un equipo seguido, con la antelación elegida."
      },
