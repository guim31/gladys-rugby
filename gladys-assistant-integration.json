{
  "manifest_version": 1,
  "type": "device",
  "name": "Rugby",
  "description": {
    "en": "Your rugby teams: next match, live score, results and rank (Top 14, Six Nations, Champions Cup…).",
    "fr": "Vos équipes de rugby : prochain match, score en direct, résultats, classement (Top 14, Six Nations)",
    "de": "Deine Rugby-Teams: nächstes Spiel, Live-Stand, Ergebnisse und Platz (Top 14, Six Nations…).",
    "es": "Sus equipos de rugby: próximo partido, marcador en directo, resultados y clasificación (Top 14…)."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/guim31/gladys-rugby:1.0.1",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-rugby/main/cover.png",
  "categories": ["leisure"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "How it works",
        "fr": "Fonctionnement",
        "de": "So funktioniert es",
        "es": "Funcionamiento"
      },
      "description": {
        "en": "Matches, scores and standings come from ESPN's public data, without account or key. Tick your competitions and save, then add your teams in the Discover tab: one device per team.",
        "fr": "Les matchs, scores et classements viennent des données publiques d'ESPN, sans compte ni clé. Cochez vos compétitions et enregistrez, puis ajoutez vos équipes dans l'onglet Découverte : un appareil par équipe.",
        "de": "Spiele, Punktestände und Tabellen kommen aus den öffentlichen Daten von ESPN, ohne Konto und Schlüssel. Kreuze deine Wettbewerbe an und speichere, dann füge deine Teams im Tab „Entdecken“ hinzu: ein Gerät pro Team.",
        "es": "Los partidos, marcadores y clasificaciones vienen de los datos públicos de ESPN, sin cuenta ni clave. Marque sus competiciones y guarde, luego añada sus equipos en la pestaña Descubrir: un dispositivo por equipo."
      }
    },
    {
      "key": "competitions",
      "type": "multi_select",
      "label": {
        "en": "Competitions",
        "fr": "Compétitions",
        "de": "Wettbewerbe",
        "es": "Competiciones"
      },
      "description": {
        "en": "Their teams are offered in the Discover tab, and their matches are read for the teams you follow. The rank comes from the first one in this list.",
        "fr": "Leurs équipes sont proposées dans l'onglet Découverte, et leurs matchs sont lus pour les équipes suivies. Le classement vient de la première de cette liste.",
        "de": "Deren Teams erscheinen im Tab „Entdecken“, und deren Spiele werden für deine Teams gelesen. Der Tabellenplatz kommt vom ersten Wettbewerb dieser Liste.",
        "es": "Sus equipos aparecen en la pestaña Descubrir y sus partidos se leen para los equipos seguidos. La clasificación viene de la primera de esta lista."
      },
      "required": false,
      "default": ["top14", "champions_cup", "six_nations", "nations_championship"],
      "options": [
        {
          "value": "top14",
          "label": {
            "en": "Top 14",
            "fr": "Top 14",
            "de": "Top 14",
            "es": "Top 14"
          }
        },
        {
          "value": "premiership",
          "label": {
            "en": "Premiership (England)",
            "fr": "Premiership (Angleterre)",
            "de": "Premiership (England)",
            "es": "Premiership (Inglaterra)"
          }
        },
        {
